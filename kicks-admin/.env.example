# Admin frontend environment. Copy to .env for local development.
# Production values belong in the hosting dashboard, never in git.
VITE_API_URL=http://localhost:5000/api/v1
VITE_SENTRY_DSN=
# Absolute origin of the customer storefront app (used only by the explicit
# Storefront button). Empty hides the button instead of linking a dead route.
# Example: VITE_STOREFRONT_URL=https://aj-sports.example.com
VITE_STOREFRONT_URL=
