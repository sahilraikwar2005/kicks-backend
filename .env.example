PORT=5000
NODE_ENV=development
    

JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=KICKS <noreply@example.com>

SHIPPING_PROVIDER=shiprocket
# Development/testing only: SHIPPING_PROVIDER=mock enables the clearly-fake
# local courier (no network, no real shipments). Production MUST use
# SHIPPING_PROVIDER=delhivery with MOCK_SHIPPING_ENABLED=false.
MOCK_SHIPPING_ENABLED=true
SHIPPING_API_KEY=your_key
SHIPPING_API_SECRET=your_secret
SHIPPING_PICKUP_LOCATION=your_pickup_location
SHIPPING_WEBHOOK_SECRET=your_webhook_secret
SHIPPING_WEIGHT_KG=1
SHIPPING_LENGTH_CM=10
SHIPPING_BREADTH_CM=10
SHIPPING_HEIGHT_CM=10

SESSION_SECRET=replace_with_long_random_string
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
UPLOAD_LIMIT_MB=5
MAX_REQUEST_BODY_SIZE=10mb

# CAPTCHA is OFF unless explicitly enabled. Set to true plus valid keys/domain to restore it.
CAPTCHA_ENABLED=false
# Frontend signup widget consumes VITE_RECAPTCHA_SITE_KEY (see kicks-frontend/.env.example).
# The backend only needs the secret below to verify tokens server-side.
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

LOG_LEVEL=info
